{
  "name": "copuno-gestion-partes",
  "version": "1.13.5",
  "description": "Aplicación web para gestión de partes de trabajo con backend en Notion",
  "main": "index.js",
  "scripts": {
    "explore": "node scripts/explore-notion-direct.js",
    "dev": "vite",
    "build": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "server": "node server.js",
    "dev:full": "npm run build && npm run server",
    "test:smoke": "node --test src-server/tests/smoke/*.test.js",
    "test:unit": "node --test src-server/tests/unit/*.test.js",
    "test": "npm run test:smoke && npm run test:unit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.263.1",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "nodemon": "^3.0.0",
